POST http://localhost:8000/api/v1/jsonrpc
Content-Type: application/json
A2A-Version: 1.0

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "SendMessage",
  "params": {
    "message": {
      
      "messageId": "{{$uuid}}",
      "role": "ROLE_USER",
      "parts": [
        {
          "text": "What's the weather in San Francisco?"
        }
      ]
    }
  }
}
